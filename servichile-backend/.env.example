# Copie este archivo a .env y complete los valores. Nunca suba .env al repositorio.

APP_ENV=local

# PostgreSQL. En Cloud Run use el socket del Cloud SQL Auth Proxy:
# postgresql+psycopg://USUARIO:CLAVE@/servichile?host=/cloudsql/PROYECTO:REGION:INSTANCIA
DATABASE_URL=postgresql+psycopg://servichile:CAMBIAR@localhost:5432/servichile

# Genere uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_MINUTES=60
REPORTE_EXPIRES_MINUTES=15

CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501

CIBER_SONDA=fake
RUT_VERIFIER=fake

# Ticket API Mercado Público (ChileCompra). No subir al repo.
# CHILECOMPRA_TICKET=
# CHILECOMPRA_MODE=auto

# ApiGateway SII Info. Contribuyentes.
# APIGATEWAY_TOKEN=
# SII_MODE=auto

# API CMF Bancos (https://api.cmfchile.cl). Sync: python -m scripts.sincronizar_cmf
# CMF_API_KEY=
# CMF_MODE=auto

# Incidentes públicos: solo Tavily + filtro heurístico (sin LLM).
# INCIDENTES_MODE=auto
# TAVILY_API_KEY=

# Google Places API (New): rating + userRatingCount para resenas-reclamos.
# Habilite Places API (New) en Google Cloud. Text Search con rating usa SKU Enterprise.
# GOOGLE_PLACES_API_KEY=
# PLACES_MODE=auto
# PLACES_MODE=fake

REDIS_URL=
LOGIN_RATE_PER_MINUTE=5
LOGIN_IP_RATE_PER_MINUTE=20
TRUST_PROXY=false
