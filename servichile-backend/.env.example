# Mínimo para local. Defaults del resto → app/configuracion.py
# cloud / DB remota / SERVICHILE_DEPLOY=1 → APP_ENV=production
APP_ENV=local
DATABASE_URL=postgresql+psycopg://servichile:CAMBIAR@localhost:5432/servichile
JWT_SECRET=
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501
REDIS_URL=redis://localhost:6379/0
PUBLIC_FRONTEND_URL=http://localhost:5500/index.html

# Vacío = simula Places / ChileCompra.
CHILECOMPRA_TICKET=
GOOGLE_PLACES_API_KEY=

# SMTP comprobantes. Local: Mailhog (1025 / UI 8025). Prod: host real + STARTTLS.
# docker run -d --name servichile-mailhog -p 1025:1025 -p 8025:8025 mailhog/mailhog
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_DESDE=noreply@servichile.local
SMTP_STARTTLS=false

# Solo production (obligatorio, ≠ JWT_SECRET, ≥32 chars):
# PRINT_TOKEN_SECRET=
# TRANSBANK_COMMERCE_CODE=
# TRANSBANK_API_KEY=
# TRANSBANK_HOST=https://webpay3g.transbank.cl
# SMTP_HOST=…  SMTP_PORT=587  SMTP_USUARIO=…  SMTP_CLAVE=…  SMTP_STARTTLS=true
