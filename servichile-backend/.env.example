APP_ENV=local
DATABASE_URL=postgresql+psycopg://servichile:CAMBIAR@localhost:5432/servichile

JWT_SECRET=
JWT_EXPIRES_MINUTES=60
REPORTE_EXPIRES_MINUTES=15

CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501

RUT_VERIFIER=muestra

REDIS_URL=
LOGIN_RATE_PER_MINUTE=5
LOGIN_IP_RATE_PER_MINUTE=20
TRUST_PROXY=false

BIOMETRIA_DIR=var/biometria
BIOMETRIA_RETENCION_DIAS=180
BIOMETRIA_MAX_LADO=640
BIOMETRIA_JPEG_QUALITY=75

CEDULA_DIR=var/cedulas
CEDULA_RETENCION_DIAS=180
CEDULA_MAX_LADO=1600
CEDULA_JPEG_QUALITY=82
CEDULA_OCR=tesseract

PADES_CA_PEM=app/infraestructura/certs/ca_chile.pem

# Rater: RATER_MODE=muestra → scores fijos. produccion → APIs reales.
# Places: GOOGLE_PLACES_API_KEY vacío → muestra; con key → produccion.
# ChileCompra: CHILECOMPRA_TICKET vacío → muestra; con ticket → produccion.
RATER_MODE=muestra
RATER_BUDGET_SECONDS=2.0
RATER_REFRESH_MINUTES=30
CHILECOMPRA_TICKET=
GOOGLE_PLACES_API_KEY=
