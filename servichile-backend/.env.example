# local | test | production.
# En cloud, VPS con DB remota, o con SERVICHILE_DEPLOY=1 /
# SERVICHILE_REQUIRE_PRODUCTION=1 → debe ser production.
APP_ENV=local
# SERVICHILE_DEPLOY=1
# SERVICHILE_REQUIRE_PRODUCTION=1
DATABASE_URL=postgresql+psycopg://servichile:CAMBIAR@localhost:5432/servichile

JWT_SECRET=
JWT_EXPIRES_MINUTES=60
REPORTE_EXPIRES_MINUTES=15

CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501

# Obligatorio en APP_ENV=production (rate limits entre réplicas).
REDIS_URL=
LOGIN_RATE_PER_MINUTE=5
LOGIN_IP_RATE_PER_MINUTE=20
TRUST_PROXY=false

BIOMETRIA_DIR=var/biometria
BIOMETRIA_RETENCION_DIAS=180
BIOMETRIA_MAX_LADO=640
BIOMETRIA_JPEG_QUALITY=75

CEDULA_DIR=var/cedulas
CEDULA_RETENCION_DIAS=180
CEDULA_MAX_LADO=1600
CEDULA_JPEG_QUALITY=82
CEDULA_OCR=tesseract

PADES_CA_PEM=app/infraestructura/certs/ca_chile.pem

# Rater: sin key Places/ChileCompra → se simulan solo esas fuentes.
# rastreador_web del sitio no necesita API key.
# RUT_VERIFIER se deriva solo (test→muestra; con ticket→chilecompra; si no→estricto).
RATER_BUDGET_SECONDS=4.0
RATER_REFRESH_MINUTES=30
CHILECOMPRA_TICKET=
GOOGLE_PLACES_API_KEY=

# SMTP de ServiChile: comprobante del informe al correo del registro (texto).
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_DESDE=

# Webpay Plus. En local/test: integración OK. En APP_ENV=production: obligatorias reales
# (webpay3gint / commerce 597055555532 se rechazan al arrancar).
# Fallback si el front no envía return_url. Preferir localhost (mismo origin que la PWA).
PUBLIC_FRONTEND_URL=http://localhost:5500/index.html
TRANSBANK_COMMERCE_CODE=597055555532
TRANSBANK_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
TRANSBANK_HOST=https://webpay3gint.transbank.cl
PAGOS_INFORME_MONTO=9990
PAGOS_PUBLICACION_MONTO=8990
PAGOS_RECLAMO_EMAIL=pagos@servichile.cl
PAGOS_RECLAMO_WHATSAPP=+56912345678
# Polling TBK de pendientes sin retorno del navegador (0=off). Min edad en segundos.
PAGOS_RECONCILIAR_SECONDS=120
PAGOS_RECONCILIAR_MIN_EDAD_SEG=180
# Obligatorio en production y distinto de JWT_SECRET (sello PDF).
PRINT_TOKEN_SECRET=
