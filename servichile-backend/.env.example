# Copie este archivo a .env y complete los valores. Nunca suba .env al repositorio.

APP_ENV=local

# PostgreSQL con pgvector. En Cloud Run use el socket del Cloud SQL Auth Proxy:
# postgresql+psycopg://USUARIO:CLAVE@/servichile?host=/cloudsql/PROYECTO:REGION:INSTANCIA
DATABASE_URL=postgresql+psycopg://servichile:CAMBIAR@localhost:5432/servichile

# Genere uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_MINUTES=60

# Orígenes del frontend permitidos, separados por coma
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501

# fake: respuestas de prueba sin enviar datos a ningún servicio
# gemini: Vertex AI (requiere GCP_PROJECT y credenciales de Google Cloud)
LLM_PROVIDER=fake
# Adaptadores del Pasaporte de Confianza. Hoy solo existe "fake" (no llama a servicios externos).
RUT_VERIFIER=fake
PDF_EXTRACTOR=fake
GCP_PROJECT=
# Proyectos que la API se niega a usar con Gemini, separados por coma
GCP_PROYECTOS_PROHIBIDOS=
GCP_LOCATION=southamerica-east1
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
# Debe coincidir con vector(768) en db/init_script.sql
EMBEDDING_DIM=768

RAG_TOP_K=5
RAG_MAX_DISTANCE=0.5

# Vacío: rate limiting en memoria (solo desarrollo). Producción: redis://HOST:6379/0
REDIS_URL=
LOGIN_RATE_PER_MINUTE=5
# Por IP: 20 por minuto para no bloquear hogares o redes que comparten una misma IP
LOGIN_IP_RATE_PER_MINUTE=20
# true solo detrás de Cloud Run (o un proxy que agregue X-Forwarded-For). En local, false.
TRUST_PROXY=false
CONSULTA_RATE_PER_MINUTE=10
